{
  "$schema": "./skin.schema.json",
  "id": "graphite",
  "name": "Graphite",
  "description": "Monochrome and flat: no shadows, small corners, compact striped lists.",
  "author": "Rust Commander",
  "version": "1.0.0",
  "license": "MIT",
  "style": {
    "radius": 3,
    "panelRadius": 4,
    "density": "compact",
    "stripes": true
  },
  "light": {
    "red": "#b4413c",
    "orange": "#a8652a",
    "yellow": "#9c7a2a",
    "green": "#4b7d55",
    "teal": "#3f7a75",
    "cyan": "#44728a",
    "blue": "#4a6491",
    "purple": "#6f5a8c",
    "pink": "#8f5674",
    "bg": "#e7e7e9",
    "chrome": "#f3f3f4",
    "surface": "#ffffff",
    "backdrop": "rgba(0, 0, 0, 0.3)",
    "shadow": "none",
    "shadow-lg": "0 12px 32px rgba(0, 0, 0, 0.16), 0 0 0 1px rgba(0, 0, 0, 0.06)",
    "text": "#18181b",
    "accent": "#27272a",
    "accent-fg": "#ffffff",
    "sel-fg": "#000000"
  },
  "dark": {
    "red": "#d4776f",
    "orange": "#d09a6a",
    "yellow": "#cdb06a",
    "green": "#85b08c",
    "teal": "#7fb3ac",
    "cyan": "#86aec2",
    "blue": "#8ea3c8",
    "purple": "#a898c4",
    "pink": "#c493ad",
    "bg": "#0c0c0d",
    "chrome": "#121214",
    "surface": "#18181b",
    "backdrop": "rgba(0, 0, 0, 0.6)",
    "shadow": "none",
    "shadow-lg": "0 16px 48px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.06)",
    "text": "#f4f4f5",
    "accent": "#e4e4e7",
    "accent-fg": "#18181b",
    "sel-fg": "#ffffff"
  }
}
