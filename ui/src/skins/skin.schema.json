{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bobnautic/rustcommander/main/ui/src/skins/skin.schema.json",
  "title": "Rust Commander skin",
  "description": "A skin for Rust Commander. See docs/src/guide/creating-skins.md. This file is generated by `node scripts/skins.mjs schema`.",
  "type": "object",
  "required": [
    "id",
    "name"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "description": "Unique id: a-z, 0-9, - and _ (also the file name)."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "Name shown in the skin gallery."
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "author": {
      "type": "string",
      "maxLength": 500
    },
    "version": {
      "type": "string",
      "maxLength": 500
    },
    "license": {
      "type": "string",
      "maxLength": 500
    },
    "extends": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "description": "Id of the skin this one builds on (default: \"default\")."
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fontUi": {
          "type": "string",
          "description": "CSS font-family of the user interface."
        },
        "fontMono": {
          "type": "string",
          "description": "CSS font-family of monospaced text."
        },
        "radius": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16,
          "description": "Corner radius of buttons and inputs (px)."
        },
        "panelRadius": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24,
          "description": "Corner radius of panels, menus and dialogs (px)."
        },
        "density": {
          "enum": [
            "compact",
            "normal",
            "comfortable"
          ],
          "description": "Row height of the file lists."
        },
        "listFontSize": {
          "type": "integer",
          "minimum": 10,
          "maximum": 20,
          "description": "Font size of the file lists (px)."
        },
        "stripes": {
          "type": "boolean",
          "description": "Alternating row backgrounds in the file lists."
        }
      }
    },
    "light": {
      "$ref": "#/$defs/variant",
      "description": "Token values of the light variant."
    },
    "dark": {
      "$ref": "#/$defs/variant",
      "description": "Token values of the dark variant."
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "description": "A CSS color: #rgb, #rrggbb, #rrggbbaa, rgb(), rgba(), hsl(), hsla(), black, white or transparent.",
      "pattern": "^\\s*(#[0-9a-fA-F]{3,8}|(rgb|rgba|hsl|hsla)\\([^()]*\\)|black|white|transparent)\\s*$"
    },
    "shadow": {
      "type": "string",
      "description": "A CSS box-shadow (lengths and colors) or \"none\"."
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "red": {
          "description": "Palette hue \"red\". File icons, status, terminal and syntax colors are derived from the palette. (group: palette)",
          "$ref": "#/$defs/color"
        },
        "orange": {
          "description": "Palette hue \"orange\". File icons, status, terminal and syntax colors are derived from the palette. (group: palette)",
          "$ref": "#/$defs/color"
        },
        "yellow": {
          "description": "Palette hue \"yellow\". File icons, status, terminal and syntax colors are derived from the palette. (group: palette)",
          "$ref": "#/$defs/color"
        },
        "green": {
          "description": "Palette hue \"green\". File icons, status, terminal and syntax colors are derived from the palette. (group: palette)",
          "$ref": "#/$defs/color"
        },
        "teal": {
          "description": "Palette hue \"teal\". File icons, status, terminal and syntax colors are derived from the palette. (group: palette)",
          "$ref": "#/$defs/color"
        },
        "cyan": {
          "description": "Palette hue \"cyan\". File icons, status, terminal and syntax colors are derived from the palette. (group: palette)",
          "$ref": "#/$defs/color"
        },
        "blue": {
          "description": "Palette hue \"blue\". File icons, status, terminal and syntax colors are derived from the palette. (group: palette)",
          "$ref": "#/$defs/color"
        },
        "purple": {
          "description": "Palette hue \"purple\". File icons, status, terminal and syntax colors are derived from the palette. (group: palette)",
          "$ref": "#/$defs/color"
        },
        "pink": {
          "description": "Palette hue \"pink\". File icons, status, terminal and syntax colors are derived from the palette. (group: palette)",
          "$ref": "#/$defs/color"
        },
        "bg": {
          "description": "Window background: around the panels and behind the active session tab. (group: base)",
          "$ref": "#/$defs/color"
        },
        "chrome": {
          "description": "Menu bar, session tabs, sidebar, status bar and function key bar. (group: base)",
          "$ref": "#/$defs/color"
        },
        "surface": {
          "description": "Panels, dialogs, menus and cards. (group: base)",
          "$ref": "#/$defs/color"
        },
        "surface-2": {
          "description": "Panel headers, column headers and panel status lines. (group: base)",
          "$ref": "#/$defs/color"
        },
        "surface-3": {
          "description": "Hover and pressed backgrounds, segmented controls, progress tracks. (group: base)",
          "$ref": "#/$defs/color"
        },
        "input-bg": {
          "description": "Text fields and drop-down lists. (group: base)",
          "$ref": "#/$defs/color"
        },
        "hover": {
          "description": "Row under the mouse pointer. (group: base)",
          "$ref": "#/$defs/color"
        },
        "border": {
          "description": "Borders of panels, dialogs and tables. (group: base)",
          "$ref": "#/$defs/color"
        },
        "border-soft": {
          "description": "Subtle separators. (group: base)",
          "$ref": "#/$defs/color"
        },
        "border-strong": {
          "description": "Borders of buttons and inputs. (group: base)",
          "$ref": "#/$defs/color"
        },
        "scroll": {
          "description": "Scrollbar thumbs. (group: base)",
          "$ref": "#/$defs/color"
        },
        "backdrop": {
          "description": "Shade behind modal dialogs (use a translucent color). (group: base)",
          "$ref": "#/$defs/color"
        },
        "shadow": {
          "description": "Shadow of panels and cards: a CSS box-shadow, or \"none\" for a flat look. (group: base)",
          "$ref": "#/$defs/shadow"
        },
        "shadow-lg": {
          "description": "Shadow of menus, dialogs and notifications: a CSS box-shadow or \"none\". (group: base)",
          "$ref": "#/$defs/shadow"
        },
        "text": {
          "description": "Main text color. (group: text)",
          "$ref": "#/$defs/color"
        },
        "text-2": {
          "description": "Secondary text: other columns, labels, inactive tabs. (group: text)",
          "$ref": "#/$defs/color"
        },
        "muted": {
          "description": "Hints, placeholders, status texts. (group: text)",
          "$ref": "#/$defs/color"
        },
        "faint": {
          "description": "Very low-emphasis text and decorations (separators, line numbers). (group: text)",
          "$ref": "#/$defs/color"
        },
        "accent": {
          "description": "Buttons, links, focus rings, the active panel, highlighted menu items, progress bars. (group: accent)",
          "$ref": "#/$defs/color"
        },
        "accent-hover": {
          "description": "Primary buttons under the mouse pointer. (group: accent)",
          "$ref": "#/$defs/color"
        },
        "accent-fg": {
          "description": "Text on accent-colored backgrounds. (group: accent)",
          "$ref": "#/$defs/color"
        },
        "accent-weak": {
          "description": "Light accent tint (active rows, drop zones). (group: accent)",
          "$ref": "#/$defs/color"
        },
        "accent-weak-2": {
          "description": "Stronger accent tint (focus glow, active toggle buttons). (group: accent)",
          "$ref": "#/$defs/color"
        },
        "accent-border": {
          "description": "Border of the active panel. (group: accent)",
          "$ref": "#/$defs/color"
        },
        "brand": {
          "description": "The Rust Commander logo color. (group: accent)",
          "$ref": "#/$defs/color"
        },
        "sel-bg": {
          "description": "Background of marked (selected) files. (group: selection)",
          "$ref": "#/$defs/color"
        },
        "sel-fg": {
          "description": "Text of marked files. (group: selection)",
          "$ref": "#/$defs/color"
        },
        "cursor-bg": {
          "description": "The file cursor in the active panel. (group: selection)",
          "$ref": "#/$defs/color"
        },
        "cursor-fg": {
          "description": "Text on the file cursor. Optional: without it the text keeps its color. (group: selection)",
          "$ref": "#/$defs/color"
        },
        "row-alt": {
          "description": "Every other row of the file lists when striped rows are on. (group: selection)",
          "$ref": "#/$defs/color"
        },
        "dir-fg": {
          "description": "Names of folders in the file lists. Optional: without it folders look like files. (group: selection)",
          "$ref": "#/$defs/color"
        },
        "ok": {
          "description": "Success: finished jobs, identical files, connected. (group: status)",
          "$ref": "#/$defs/color"
        },
        "ok-weak": {
          "description": "Background of success messages. (group: status)",
          "$ref": "#/$defs/color"
        },
        "ok-border": {
          "description": "Border of success messages. (group: status)",
          "$ref": "#/$defs/color"
        },
        "warn": {
          "description": "Warnings: different files, attention. (group: status)",
          "$ref": "#/$defs/color"
        },
        "warn-weak": {
          "description": "Background of warnings. (group: status)",
          "$ref": "#/$defs/color"
        },
        "err": {
          "description": "Errors and destructive actions. (group: status)",
          "$ref": "#/$defs/color"
        },
        "err-weak": {
          "description": "Background of error messages. (group: status)",
          "$ref": "#/$defs/color"
        },
        "err-border": {
          "description": "Border of error messages. (group: status)",
          "$ref": "#/$defs/color"
        },
        "menubar-bg": {
          "description": "Background of the menu bar. Optional: default is \"chrome\". (group: chrome)",
          "$ref": "#/$defs/color"
        },
        "menubar-fg": {
          "description": "Menu titles and toolbar icons. Optional. (group: chrome)",
          "$ref": "#/$defs/color"
        },
        "key-bg": {
          "description": "Background of the function key labels (F1–F10). Optional: default is \"surface-3\". (group: chrome)",
          "$ref": "#/$defs/color"
        },
        "key-fg": {
          "description": "Text of the function key labels. Optional: default is \"text-2\". (group: chrome)",
          "$ref": "#/$defs/color"
        },
        "key-num": {
          "description": "Numbers of the function keys. Optional: default is \"muted\". (group: chrome)",
          "$ref": "#/$defs/color"
        },
        "fi-file": {
          "description": "Files without a known type. (group: files)",
          "$ref": "#/$defs/color"
        },
        "fi-dir": {
          "description": "Folder icons (outline). (group: files)",
          "$ref": "#/$defs/color"
        },
        "fi-dir-fill": {
          "description": "Folder icons (fill). (group: files)",
          "$ref": "#/$defs/color"
        },
        "fi-image": {
          "description": "Images. (group: files)",
          "$ref": "#/$defs/color"
        },
        "fi-video": {
          "description": "Videos. (group: files)",
          "$ref": "#/$defs/color"
        },
        "fi-audio": {
          "description": "Audio files. (group: files)",
          "$ref": "#/$defs/color"
        },
        "fi-archive": {
          "description": "Archives (zip, tar, …). (group: files)",
          "$ref": "#/$defs/color"
        },
        "fi-code": {
          "description": "Source code. (group: files)",
          "$ref": "#/$defs/color"
        },
        "fi-script": {
          "description": "Scripts (sh, py, …). (group: files)",
          "$ref": "#/$defs/color"
        },
        "fi-config": {
          "description": "Configuration files (json, yaml, toml, …). (group: files)",
          "$ref": "#/$defs/color"
        },
        "fi-text": {
          "description": "Text files. (group: files)",
          "$ref": "#/$defs/color"
        },
        "fi-document": {
          "description": "Documents (pdf, doc, …). (group: files)",
          "$ref": "#/$defs/color"
        },
        "fi-spreadsheet": {
          "description": "Spreadsheets. (group: files)",
          "$ref": "#/$defs/color"
        },
        "fi-presentation": {
          "description": "Presentations. (group: files)",
          "$ref": "#/$defs/color"
        },
        "fi-key": {
          "description": "Keys and certificates. (group: files)",
          "$ref": "#/$defs/color"
        },
        "fi-executable": {
          "description": "Programs. (group: files)",
          "$ref": "#/$defs/color"
        },
        "fi-font": {
          "description": "Fonts. (group: files)",
          "$ref": "#/$defs/color"
        },
        "fi-database": {
          "description": "Databases. (group: files)",
          "$ref": "#/$defs/color"
        },
        "fi-disk": {
          "description": "Disk images. (group: files)",
          "$ref": "#/$defs/color"
        },
        "fi-link": {
          "description": "Symbolic links. (group: files)",
          "$ref": "#/$defs/color"
        },
        "term-bg": {
          "description": "Terminal background. (group: terminal)",
          "$ref": "#/$defs/color"
        },
        "term-fg": {
          "description": "Terminal text. (group: terminal)",
          "$ref": "#/$defs/color"
        },
        "term-cursor": {
          "description": "Terminal cursor. (group: terminal)",
          "$ref": "#/$defs/color"
        },
        "term-selection": {
          "description": "Selected text in the terminal. (group: terminal)",
          "$ref": "#/$defs/color"
        },
        "term-black": {
          "description": "ANSI black. (group: terminal)",
          "$ref": "#/$defs/color"
        },
        "term-red": {
          "description": "ANSI red. (group: terminal)",
          "$ref": "#/$defs/color"
        },
        "term-green": {
          "description": "ANSI green. (group: terminal)",
          "$ref": "#/$defs/color"
        },
        "term-yellow": {
          "description": "ANSI yellow. (group: terminal)",
          "$ref": "#/$defs/color"
        },
        "term-blue": {
          "description": "ANSI blue. (group: terminal)",
          "$ref": "#/$defs/color"
        },
        "term-magenta": {
          "description": "ANSI magenta. (group: terminal)",
          "$ref": "#/$defs/color"
        },
        "term-cyan": {
          "description": "ANSI cyan. (group: terminal)",
          "$ref": "#/$defs/color"
        },
        "term-white": {
          "description": "ANSI white. (group: terminal)",
          "$ref": "#/$defs/color"
        },
        "term-bright-black": {
          "description": "ANSI bright black (often used for gray text). (group: terminal)",
          "$ref": "#/$defs/color"
        },
        "term-bright-red": {
          "description": "ANSI bright red. (group: terminal)",
          "$ref": "#/$defs/color"
        },
        "term-bright-green": {
          "description": "ANSI bright green. (group: terminal)",
          "$ref": "#/$defs/color"
        },
        "term-bright-yellow": {
          "description": "ANSI bright yellow. (group: terminal)",
          "$ref": "#/$defs/color"
        },
        "term-bright-blue": {
          "description": "ANSI bright blue. (group: terminal)",
          "$ref": "#/$defs/color"
        },
        "term-bright-magenta": {
          "description": "ANSI bright magenta. (group: terminal)",
          "$ref": "#/$defs/color"
        },
        "term-bright-cyan": {
          "description": "ANSI bright cyan. (group: terminal)",
          "$ref": "#/$defs/color"
        },
        "term-bright-white": {
          "description": "ANSI bright white. (group: terminal)",
          "$ref": "#/$defs/color"
        },
        "syn-keyword": {
          "description": "Keywords (if, fn, return). (group: syntax)",
          "$ref": "#/$defs/color"
        },
        "syn-string": {
          "description": "Strings. (group: syntax)",
          "$ref": "#/$defs/color"
        },
        "syn-number": {
          "description": "Numbers. (group: syntax)",
          "$ref": "#/$defs/color"
        },
        "syn-constant": {
          "description": "Constants, booleans, null. (group: syntax)",
          "$ref": "#/$defs/color"
        },
        "syn-comment": {
          "description": "Comments. (group: syntax)",
          "$ref": "#/$defs/color"
        },
        "syn-function": {
          "description": "Function and method names. (group: syntax)",
          "$ref": "#/$defs/color"
        },
        "syn-type": {
          "description": "Types, classes, namespaces. (group: syntax)",
          "$ref": "#/$defs/color"
        },
        "syn-property": {
          "description": "Properties and keys. (group: syntax)",
          "$ref": "#/$defs/color"
        },
        "syn-variable": {
          "description": "Variables. (group: syntax)",
          "$ref": "#/$defs/color"
        },
        "syn-operator": {
          "description": "Operators. (group: syntax)",
          "$ref": "#/$defs/color"
        },
        "syn-tag": {
          "description": "HTML/XML tags. (group: syntax)",
          "$ref": "#/$defs/color"
        },
        "syn-attribute": {
          "description": "HTML/XML attributes. (group: syntax)",
          "$ref": "#/$defs/color"
        },
        "syn-heading": {
          "description": "Markdown headings. (group: syntax)",
          "$ref": "#/$defs/color"
        },
        "syn-link": {
          "description": "Links and URLs. (group: syntax)",
          "$ref": "#/$defs/color"
        },
        "syn-invalid": {
          "description": "Invalid code. (group: syntax)",
          "$ref": "#/$defs/color"
        },
        "syn-meta": {
          "description": "Annotations, preprocessor, front matter. (group: syntax)",
          "$ref": "#/$defs/color"
        },
        "syn-regexp": {
          "description": "Regular expressions and escapes. (group: syntax)",
          "$ref": "#/$defs/color"
        },
        "editor-bg": {
          "description": "Editor background. (group: editor)",
          "$ref": "#/$defs/color"
        },
        "editor-fg": {
          "description": "Editor text. (group: editor)",
          "$ref": "#/$defs/color"
        },
        "editor-gutter-bg": {
          "description": "Line number gutter background. (group: editor)",
          "$ref": "#/$defs/color"
        },
        "editor-gutter-fg": {
          "description": "Line numbers. (group: editor)",
          "$ref": "#/$defs/color"
        },
        "editor-active-line": {
          "description": "Line with the cursor. (group: editor)",
          "$ref": "#/$defs/color"
        },
        "editor-selection": {
          "description": "Selected text. (group: editor)",
          "$ref": "#/$defs/color"
        },
        "editor-cursor": {
          "description": "Text cursor. (group: editor)",
          "$ref": "#/$defs/color"
        }
      }
    }
  }
}
